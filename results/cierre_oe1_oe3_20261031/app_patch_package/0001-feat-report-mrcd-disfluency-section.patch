@@ -0,0 +1,370 @@
+/**
+ * Disfluencias por evento (motor MRCD, contrato `mrcd.analysis/v1`).
+ *
+ * Qué muestra y qué NO afirma (reglas del proyecto, no negociables):
+ * - Cada evento trae clase, inicio/fin en segundos, puntaje con la marca "no calibrado"
+ *   y procedencia. El intervalo es la franja de decisión de la ventana, no una frontera
+ *   marcada por una persona.
+ * - El puntaje NO es un porcentaje ni una probabilidad de acierto: se muestra como número
+ *   crudo del modelo, siempre junto a "no calibrado".
+ * - Lo que falta se dice ("No disponible: motivo"); jamás se rellena con 0.
+ * - No se infiere ningún estado psicológico ni se diagnostica nada. La clase es la
+ *   etiqueta de una ventana del modelo, que fue entrenado con etiquetas heurísticas.
+ * - No hay estado "incierto": el motor no lo emite, así que esta pantalla tampoco lo inventa.
+ */
+import { useRef } from "react";
+
+import {
+  mrcdServiceUrl,
+  type MrcdAnalysis,
+  type MrcdEvent,
+} from "../../../shared/api/mrcd-service";
+import { useMrcdAnalysis } from "../lib/use-mrcd-analysis";
+
+/** Solo presentación: la clave interna (inglés) se conserva y se muestra al lado. */
+const CLASS_LABEL_ES: Record<string, string> = {
+  fluent: "fluido",
+  filler_word: "muletilla",
+  prolongation: "prolongación",
+  repetition: "repetición",
+  block: "bloqueo",
+  revision: "reparación",
+  rhetorical_pause: "pausa retórica",
+  neutral_pause: "pausa neutra",
+};
+
+const MODALITY_LABEL_ES = {
+  acoustic: "Acústica",
+  linguistic: "Lingüística (texto del ASR)",
+  kinesic_video: "Video",
+} as const;
+
+function classLabel(key: string): string {
+  return CLASS_LABEL_ES[key] ?? key;
+}
+
+function formatSeconds(value: number): string {
+  return `${value.toFixed(1)} s`;
+}
+
+function shortHash(value: unknown): string | null {
+  return typeof value === "string" && value.length >= 12
+    ? value.slice(0, 12)
+    : null;
+}
+
+function Unavailable({ reason }: { reason: string }) {
+  return (
+    <span className="text-ink-faint">
+      No disponible<span className="text-ink-soft">: {reason}</span>
+    </span>
+  );
+}
+
+/**
+ * Clases sin referencia humana compatible (contrato de integración B.6, regla 3): se muestran
+ * solo como salida técnica con esta marca, nunca como hallazgo validado.
+ */
+const UNVALIDATED_CLASSES = new Set([
+  "block",
+  "rhetorical_pause",
+  "neutral_pause",
+  "revision",
+]);
+
+function EventRow({ event }: { event: MrcdEvent }) {
+  return (
+    <tr className="border-t border-line align-top">
+      <td className="py-2 pr-4">
+        <span className="font-semibold text-ink">
+          {classLabel(event.class)}
+        </span>{" "}
+        <span className="font-mono text-[10px] text-ink-faint">
+          {event.class}
+        </span>
+        {UNVALIDATED_CLASSES.has(event.class) && (
+          <span className="ml-2 rounded border border-line px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-[0.12em] text-ink-soft">
+            Salida técnica sin validar
+          </span>
+        )}
+        {event.experimental && (
+          <span className="ml-2 rounded border border-line px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-[0.12em] text-ink-soft">
+            Experimental
+          </span>
+        )}
+        {event.validation && (
+          <p className="mt-1 max-w-prose text-[11px] leading-snug text-ink-soft">
+            {event.validation}
+          </p>
+        )}
+      </td>
+      <td className="py-2 pr-4 font-mono tabular-nums text-ink">
+        {formatSeconds(event.start_s)} – {formatSeconds(event.end_s)}
+      </td>
+      <td className="py-2 pr-4 font-mono tabular-nums text-ink">
+        {event.score.value.toFixed(2)}{" "}
+        <span className="font-sans text-[10px] font-semibold uppercase tracking-[0.12em] text-ink-faint">
+          no calibrado
+        </span>
+      </td>
+      <td className="py-2 font-mono tabular-nums text-ink-soft">
+        {event.n_windows}
+      </td>
+    </tr>
+  );
+}
+
+export interface DisfluencyAnalysisViewProps {
+  analysis: MrcdAnalysis;
+}
+
+/** Vista pura de un análisis ya validado. */
+export function DisfluencyAnalysisView({
+  analysis,
+}: DisfluencyAnalysisViewProps) {
+  const { provenance, modalities, summary } = analysis;
+  const checkpoint = provenance.checkpoint;
+  const asr = provenance.asr;
+  const config = provenance.config;
+  const events = analysis.events;
+  const epm = summary?.events_per_minute;
+
+  return (
+    <div className="flex flex-col gap-5">
+      {analysis.experimental.active && (
+        <p
+          role="note"
+          className="rounded-lg border border-line bg-surface/70 px-4 py-3 text-[12px] leading-relaxed text-ink-soft"
+        >
+          <strong className="text-ink">Resultado experimental.</strong> Se
+          usaron componentes opcionales sin validar fuera de su corpus de
+          desarrollo:{" "}
+          <span className="font-mono">
+            {analysis.experimental.components.join(", ")}
+          </span>
+          .
+        </p>
+      )}
+
+      <div className="grid gap-3 sm:grid-cols-3">
+        <div className="rounded-lg border border-line bg-surface p-4">
+          <p className="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-faint">
+            Eventos
+          </p>
+          <p className="font-display mt-1.5 text-[28px] font-extrabold leading-none tabular-nums text-ink">
+            {summary ? summary.n_events : "—"}
+          </p>
+        </div>
+        <div className="rounded-lg border border-line bg-surface p-4">
+          <p className="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-faint">
+            Eventos por minuto
+          </p>
+          <p className="mt-1.5 text-[15px] font-semibold text-ink">
+            {epm?.available ? (
+              epm.value.toFixed(1)
+            ) : (
+              <Unavailable reason={epm?.unavailable_reason ?? "sin resumen"} />
+            )}
+          </p>
+          <p className="mt-1 text-[11px] text-ink-faint">
+            {analysis.request.audio_duration_s.available ? (
+              `Audio analizado: ${formatSeconds(analysis.request.audio_duration_s.value)}`
+            ) : (
+              <Unavailable
+                reason={analysis.request.audio_duration_s.unavailable_reason}
+              />
+            )}
+          </p>
+        </div>
+        <div className="rounded-lg border border-line bg-surface p-4">
+          <p className="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-faint">
+            Modalidades
+          </p>
+          <ul className="mt-1.5 space-y-1 text-[12px] text-ink-soft">
+            {(
+              Object.keys(
+                MODALITY_LABEL_ES,
+              ) as (keyof typeof MODALITY_LABEL_ES)[]
+            ).map((key) => {
+              const status = modalities[key];
+              return (
+                <li key={key}>
+                  <span className="font-semibold text-ink">
+                    {MODALITY_LABEL_ES[key]}:
+                  </span>{" "}
+                  {status.available ? (
+                    "disponible"
+                  ) : (
+                    <Unavailable reason={status.reason} />
+                  )}
+                </li>
+              );
+            })}
+          </ul>
+        </div>
+      </div>
+
+      {events.length === 0 ? (
+        <p className="text-sm text-ink-soft">
+          El motor no emitió eventos para este audio. Esto no certifica un habla
+          fluida.
+        </p>
+      ) : (
+        <div className="overflow-x-auto">
+          <table className="w-full text-left text-[13px]">
+            <caption className="sr-only">
+              Eventos de disfluencia por ventana
+            </caption>
+            <thead>
+              <tr className="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-faint">
+                <th scope="col" className="pb-2 pr-4 font-medium">
+                  Clase
+                </th>
+                <th scope="col" className="pb-2 pr-4 font-medium">
+                  Franja de decisión
+                </th>
+                <th scope="col" className="pb-2 pr-4 font-medium">
+                  Puntaje del modelo
+                </th>
+                <th scope="col" className="pb-2 font-medium">
+                  Ventanas
+                </th>
+              </tr>
+            </thead>
+            <tbody>
+              {events.map((event) => (
+                <EventRow key={event.id} event={event} />
+              ))}
+            </tbody>
+          </table>
+          <p className="mt-2 text-[11px] leading-snug text-ink-faint">
+            La franja es la ventana de decisión del modelo, no una frontera
+            marcada por una persona. El puntaje es el máximo de la probabilidad
+            de clase en las ventanas del evento y no está calibrado: no es una
+            probabilidad de acierto.
+          </p>
+        </div>
+      )}
+
+      <dl
+        aria-label="Procedencia del análisis de disfluencias"
+        className="flex flex-wrap gap-x-5 gap-y-1 text-[11px] text-ink-faint"
+      >
+        <div className="flex gap-1.5">
+          <dt className="font-semibold uppercase tracking-[0.12em]">
+            Checkpoint
+          </dt>
+          <dd className="font-mono">
+            {String(checkpoint?.file ?? "—")}
+            {shortHash(checkpoint?.sha256)
+              ? ` · ${shortHash(checkpoint?.sha256)}`
+              : ""}
+          </dd>
+        </div>
+        <div className="flex gap-1.5">
+          <dt className="font-semibold uppercase tracking-[0.12em]">ASR</dt>
+          <dd className="font-mono">{String(asr?.profile ?? "—")}</dd>
+        </div>
+        <div className="flex gap-1.5">
+          <dt className="font-semibold uppercase tracking-[0.12em]">Cabeza</dt>
+          <dd className="font-mono">
+            {analysis.request.head ?? "ninguna (V0)"}
+          </dd>
+        </div>
+        {config && (
+          <div className="flex gap-1.5">
+            <dt className="font-semibold uppercase tracking-[0.12em]">
+              Ventana
+            </dt>
+            <dd className="font-mono">
+              {String(config.window_s)} s / paso {String(config.stride_s)} s
+            </dd>
+          </div>
+        )}
+        <div className="flex gap-1.5">
+          <dt className="font-semibold uppercase tracking-[0.12em]">
+            Contrato
+          </dt>
+          <dd className="font-mono">{analysis.schema_version}</dd>
+        </div>
+      </dl>
+
+      {analysis.warnings.length > 0 && (
+        <ul
+          aria-label="Advertencias del motor"
+          className="space-y-1.5 rounded-lg border border-line bg-surface/70 px-4 py-3 text-[12px] leading-relaxed text-ink-soft"
+        >
+          {analysis.warnings.map((w) => (
+            <li key={w.code}>
+              <span className="font-mono text-[10px] text-ink-faint">
+                {w.code}
+              </span>{" "}
+              {w.message}
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
+
+/** Panel con estado: elige un WAV, lo envía al servicio y muestra el resultado. */
+export function DisfluencyAnalysisPanel() {
+  const input = useRef<HTMLInputElement>(null);
+  const { analysis, error, pending, analyze, reset } = useMrcdAnalysis();
+
+  if (mrcdServiceUrl() === null) {
+    return (
+      <p className="text-sm text-ink-soft">
+        <Unavailable reason="el servicio de disfluencias no está configurado (VITE_MRCD_SERVICE_URL)." />
+      </p>
+    );
+  }
+
+  return (
+    <div className="flex flex-col gap-4">
+      <p className="max-w-prose text-[13px] leading-relaxed text-ink-soft">
+        Análisis experimental de disfluencias sobre un archivo de audio (WAV
+        mono, 16 kHz, 16 bits). El audio se envía solo al servicio local
+        configurado y no se guarda.
+      </p>
+      <div className="flex flex-wrap items-center gap-3">
+        <input
+          ref={input}
+          type="file"
+          accept="audio/wav,.wav"
+          aria-label="Archivo WAV para el análisis de disfluencias"
+          disabled={pending}
+          className="text-[13px] text-ink-soft"
+          onChange={(event) => {
+            const file = event.target.files?.[0];
+            if (file) analyze(file);
+          }}
+        />
+        {(analysis || error) && (
+          <button
+            type="button"
+            onClick={() => {
+              reset();
+              if (input.current) input.current.value = "";
+            }}
+            className="inline-flex h-9 items-center rounded-lg border border-line px-3 text-[13px] font-semibold text-ink-soft hover:border-line-strong hover:text-ink"
+          >
+            Limpiar
+          </button>
+        )}
+      </div>
+      {pending && (
+        <p role="status" className="text-[13px] text-ink-soft">
+          Analizando… puede tardar más que la duración del audio.
+        </p>
+      )}
+      {error && (
+        <p role="alert" className="text-[13px] text-ink">
+          No se pudo analizar el audio ({error.code}): {error.message}
+        </p>
+      )}
+      {analysis && <DisfluencyAnalysisView analysis={analysis} />}
+    </div>
+  );
+}
diff --git a/frontend/src/contexts/feedback/lib/use-mrcd-analysis.ts b/frontend/src/contexts/feedback/lib/use-mrcd-analysis.ts
new file mode 100644
index 0000000..5b73f42
--- /dev/null
+++ b/frontend/src/contexts/feedback/lib/use-mrcd-analysis.ts
@@ -0,0 +1,42 @@
+/**
+ * Estado del análisis de disfluencias (servicio MRCD) para la pantalla de reporte.
+ *
+ * Es una mutación explícita (el usuario elige el archivo), no una consulta
+ * automática: el análisis tarda más que el audio y no debe dispararse solo.
+ */
+import { useMutation } from "@tanstack/react-query";
+
+import {
+  analyzeAudioWithMrcd,
+  MrcdServiceError,
+  type MrcdAnalysis,
+} from "../../../shared/api/mrcd-service";
+
+export interface MrcdAnalysisState {
+  analysis: MrcdAnalysis | null;
+  error: { code: string; message: string } | null;
+  pending: boolean;
+  analyze: (audio: Blob) => void;
+  reset: () => void;
+}
+
+export function useMrcdAnalysis(): MrcdAnalysisState {
+  const mutation = useMutation<MrcdAnalysis, Error, Blob>({
+    mutationFn: (audio) => analyzeAudioWithMrcd(audio),
+  });
+  const err = mutation.error;
+  return {
+    analysis: mutation.data ?? null,
+    error: err
+      ? err instanceof MrcdServiceError
+        ? { code: err.code, message: err.message }
+        : {
+            code: "client_unexpected",
+            message: "Fallo inesperado del cliente.",
+          }
+      : null,
+    pending: mutation.isPending,
+    analyze: (audio) => mutation.mutate(audio),
+    reset: () => mutation.reset(),
+  };
+}
