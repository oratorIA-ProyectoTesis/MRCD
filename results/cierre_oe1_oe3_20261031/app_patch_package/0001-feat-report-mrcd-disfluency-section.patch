+/**
+ * Cliente del servicio MRCD: validación del contrato v1 con respuestas REALES del motor
+ * (fixtures generados por `python -m mrcd.service`), flujo de sondeo y errores estructurados.
+ */
+import { describe, expect, it, vi } from "vitest";
+
+import errorAudioTooShort from "./__fixtures__/mrcd/error_audio_too_short.json";
+import errorStereo from "./__fixtures__/mrcd/error_stereo.json";
+import jobFailed from "./__fixtures__/mrcd/http_job_failed_invalid_audio.json";
+import jobQueued from "./__fixtures__/mrcd/http_job_queued.json";
+import okP0 from "./__fixtures__/mrcd/response_ok_p0_v0.json";
+import okP1 from "./__fixtures__/mrcd/response_ok_p1_experimental.json";
+import {
+  analyzeAudioWithMrcd,
+  MrcdAnalysisSchema,
+  MrcdJobSchema,
+  MrcdServiceError,
+} from "./mrcd-service";
+
+const BASE = "http://127.0.0.1:8765";
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+describe("MrcdAnalysisSchema", () => {
+  it("acepta la respuesta real del motor con p0 y V0 por defecto", () => {
+    const parsed = MrcdAnalysisSchema.parse(okP0);
+    expect(parsed.status).toBe("completed");
+    expect(parsed.events.length).toBeGreaterThan(0);
+    for (const event of parsed.events) {
+      expect(event.score.calibrated).toBe(false);
+      expect(event.score.label).toBe("uncalibrated");
+    }
+    expect(parsed.experimental.active).toBe(false);
+    expect(parsed.modalities.kinesic_video.available).toBe(false);
+  });
+
+  it("marca como experimental el perfil ASR P1", () => {
+    const parsed = MrcdAnalysisSchema.parse(okP1);
+    expect(parsed.experimental).toEqual({
+      active: true,
+      components: ["asr_profile:p1_disfluent_prompt"],
+    });
+  });
+
+  it("acepta los documentos de error con su código estructurado", () => {
+    expect(MrcdAnalysisSchema.parse(errorStereo).error?.code).toBe(
+      "audio_not_mono",
+    );
+    expect(MrcdAnalysisSchema.parse(errorAudioTooShort).error?.code).toBe(
+      "audio_too_short",
+    );
+  });
+
+  it("una medida no disponible conserva null y el motivo, nunca 0", () => {
+    const failed = MrcdAnalysisSchema.parse(jobFailed.result);
+    expect(failed.request.audio_duration_s.available).toBe(false);
+    expect(failed.request.audio_duration_s.value).toBeNull();
+  });
+
+  it("rechaza un puntaje que se declare calibrado o sin la marca", () => {
+    const tampered = structuredClone(okP0);
+    tampered.events[0]!.score.calibrated = true as unknown as false;
+    expect(MrcdAnalysisSchema.safeParse(tampered).success).toBe(false);
+    const unlabeled = structuredClone(okP0);
+    unlabeled.events[0]!.score.label =
+      "calibrated" as unknown as "uncalibrated";
+    expect(MrcdAnalysisSchema.safeParse(unlabeled).success).toBe(false);
+  });
+
+  it("rechaza un valor 0 con available=false", () => {
+    const tampered = structuredClone(okP0) as unknown as {
+      summary: { events_per_minute: Record<string, unknown> };
+    };
+    tampered.summary.events_per_minute = {
+      available: false,
+      value: 0,
+      unavailable_reason: "x",
+    };
+    expect(MrcdAnalysisSchema.safeParse(tampered).success).toBe(false);
+  });
+
+  it("valida los estados de trabajo", () => {
+    expect(MrcdJobSchema.parse(jobQueued).status).toBe("queued");
+    expect(MrcdJobSchema.parse(jobFailed).result?.error?.code).toBe(
+      "invalid_audio_file",
+    );
+  });
+});
+
+describe("analyzeAudioWithMrcd", () => {
+  const audio = new Blob([new Uint8Array([1, 2, 3])], { type: "audio/wav" });
+
+  it("sin URL configurada falla como no disponible, sin red", async () => {
+    const fetchImpl = vi.fn();
+    await expect(
+      analyzeAudioWithMrcd(audio, { baseUrl: undefined, fetchImpl }),
+    ).rejects.toMatchObject({ code: "client_not_configured" });
+    expect(fetchImpl).not.toHaveBeenCalled();
+  });
+
+  it("envía el audio sin credenciales ni Authorization y espera el resultado", async () => {
+    const running = { ...jobQueued, status: "running" };
+    const done = {
+      ...jobQueued,
+      status: "completed",
+      result: okP0,
+    };
+    const fetchImpl = vi
+      .fn<typeof fetch>()
+      .mockResolvedValueOnce(json(jobQueued, 202))
+      .mockResolvedValueOnce(json(running))
+      .mockResolvedValueOnce(json(done));
+    const result = await analyzeAudioWithMrcd(audio, {
+      baseUrl: BASE,
+      fetchImpl,
+      pollIntervalMs: 1,
+    });
+    expect(result.status).toBe("completed");
+    const [firstUrl, firstInit] = fetchImpl.mock.calls[0]!;
+    expect(firstUrl).toBe(`${BASE}/v1/jobs`);
+    expect(firstInit?.method).toBe("POST");
+    expect(firstInit?.credentials).toBe("omit");
+    expect(new Headers(firstInit?.headers).has("Authorization")).toBe(false);
+    expect(fetchImpl).toHaveBeenCalledTimes(3);
+    expect(fetchImpl.mock.calls[2]![0]).toBe(
+      `${BASE}/v1/jobs/${jobQueued.job_id}`,
+    );
+  });
+
+  it("pasa el perfil ASR solo cuando se pide (el defecto p0 no se envía)", async () => {
+    const fetchImpl = vi
+      .fn<typeof fetch>()
+      .mockResolvedValueOnce(
+        json({ ...jobQueued, status: "completed", result: okP1 }, 202),
+      );
+    await analyzeAudioWithMrcd(audio, {
+      baseUrl: BASE,
+      fetchImpl,
+      asrProfile: "p1_disfluent_prompt",
+    });
+    expect(fetchImpl.mock.calls[0]![0]).toBe(
+      `${BASE}/v1/jobs?asr_profile=p1_disfluent_prompt`,
+    );
+  });
+
+  it("convierte un trabajo fallido en MrcdServiceError con el código del servicio", async () => {
+    const fetchImpl = vi
+      .fn<typeof fetch>()
+      .mockResolvedValueOnce(json(jobFailed, 202));
+    await expect(
+      analyzeAudioWithMrcd(audio, { baseUrl: BASE, fetchImpl }),
+    ).rejects.toMatchObject({ code: "invalid_audio_file", retryable: false });
+  });
+
+  it("convierte un HTTP 4xx con documento de error en MrcdServiceError", async () => {
+    const fetchImpl = vi
+      .fn<typeof fetch>()
+      .mockResolvedValueOnce(json(errorStereo, 422));
+    const promise = analyzeAudioWithMrcd(audio, { baseUrl: BASE, fetchImpl });
+    await expect(promise).rejects.toBeInstanceOf(MrcdServiceError);
+    await expect(promise).rejects.toMatchObject({ code: "audio_not_mono" });
+  });
+
+  it("informa servicio inalcanzable como reintentable", async () => {
+    const fetchImpl = vi
+      .fn<typeof fetch>()
+      .mockRejectedValue(new TypeError("fail"));
+    await expect(
+      analyzeAudioWithMrcd(audio, { baseUrl: BASE, fetchImpl }),
+    ).rejects.toMatchObject({ code: "client_unreachable", retryable: true });
+  });
+
+  it("rechaza una versión de contrato desconocida con un código propio", async () => {
+    const fetchImpl = vi
+      .fn<typeof fetch>()
+      .mockResolvedValueOnce(json({ ...jobQueued, schema_version: "mrcd.job/v2" }, 202));
+    await expect(
+      analyzeAudioWithMrcd(audio, { baseUrl: BASE, fetchImpl }),
+    ).rejects.toMatchObject({ code: "contract_version_unsupported" });
+  });
+
+  it("descarta una respuesta que viola el contrato en vez de mostrarla", async () => {
+    const bad = structuredClone(okP0);
+    bad.events[0]!.score.calibrated = true as unknown as false;
+    const fetchImpl = vi
+      .fn<typeof fetch>()
+      .mockResolvedValueOnce(
+        json({ ...jobQueued, status: "completed", result: bad }, 202),
+      );
+    await expect(
+      analyzeAudioWithMrcd(audio, { baseUrl: BASE, fetchImpl }),
+    ).rejects.toMatchObject({ code: "client_contract_violation" });
+  });
+});
