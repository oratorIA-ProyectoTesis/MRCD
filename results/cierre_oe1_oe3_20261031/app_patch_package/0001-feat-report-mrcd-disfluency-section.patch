@@ -0,0 +1,159 @@
+// @vitest-environment jsdom
+/**
+ * Sección de disfluencias del reporte: clase, tiempos, puntaje "no calibrado",
+ * procedencia, advertencias y "No disponible" — sin porcentajes ni estados psicológicos.
+ */
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, describe, expect, it } from "vitest";
+
+import errorStereo from "../../../shared/api/__fixtures__/mrcd/error_stereo.json";
+import okP0 from "../../../shared/api/__fixtures__/mrcd/response_ok_p0_v0.json";
+import okP1 from "../../../shared/api/__fixtures__/mrcd/response_ok_p1_experimental.json";
+import { MrcdAnalysisSchema } from "../../../shared/api/mrcd-service";
+import { DisfluencyAnalysisView } from "./DisfluencyEventsSection";
+
+let roots: Root[] = [];
+
+function mount(element: React.ReactElement): HTMLElement {
+  const container = document.createElement("div");
+  document.body.appendChild(container);
+  const root = createRoot(container);
+  roots.push(root);
+  act(() => {
+    root.render(element);
+  });
+  return container;
+}
+
+afterEach(() => {
+  for (const root of roots) {
+    act(() => root.unmount());
+  }
+  roots = [];
+  document.body.innerHTML = "";
+});
+
+describe("DisfluencyAnalysisView", () => {
+  const analysis = MrcdAnalysisSchema.parse(okP0);
+
+  it("muestra por evento clase, inicio/fin y puntaje marcado como no calibrado", () => {
+    const view = mount(<DisfluencyAnalysisView analysis={analysis} />);
+    const rows = view.querySelectorAll("tbody tr");
+    expect(rows.length).toBe(analysis.events.length);
+    const first = analysis.events[0]!;
+    const text = rows[0]!.textContent ?? "";
+    expect(text).toContain(first.class);
+    expect(text).toContain(`${first.start_s.toFixed(1)} s`);
+    expect(text).toContain(`${first.end_s.toFixed(1)} s`);
+    expect(text).toContain(first.score.value.toFixed(2));
+    expect(text.toLowerCase()).toContain("no calibrado");
+    expect(view.textContent).toContain("no es una probabilidad de acierto");
+  });
+
+  it("marca las clases sin referencia humana como salida técnica sin validar", () => {
+    const view = mount(<DisfluencyAnalysisView analysis={analysis} />);
+    const rows = [...view.querySelectorAll("tbody tr")];
+    const unvalidated = new Set(["block", "rhetorical_pause", "neutral_pause", "revision"]);
+    expect(rows.length).toBeGreaterThan(0);
+    analysis.events.forEach((event, i) => {
+      const marked = (rows[i]!.textContent ?? "").includes("Salida técnica sin validar");
+      expect(marked).toBe(unvalidated.has(event.class));
+    });
+  });
+
+  it("muestra la tasa por minuto junto a la duración del audio", () => {
+    const view = mount(<DisfluencyAnalysisView analysis={analysis} />);
+    expect(view.textContent).toContain("Audio analizado: 36.0 s");
+  });
+
+  it("nunca presenta el puntaje como porcentaje", () => {
+    const view = mount(<DisfluencyAnalysisView analysis={analysis} />);
+    const table = view.querySelector("table")!.textContent ?? "";
+    expect(table).not.toMatch(/\d\s?%/);
+  });
+
+  it("declara el video como no disponible con su motivo", () => {
+    const view = mount(<DisfluencyAnalysisView analysis={analysis} />);
+    const text = view.textContent ?? "";
+    expect(text).toContain("Video:");
+    expect(text).toContain("No disponible");
+    expect(text).toContain(analysis.modalities.kinesic_video.reason!);
+  });
+
+  it("muestra la procedencia: checkpoint con hash corto, perfil ASR, cabeza y contrato", () => {
+    const view = mount(<DisfluencyAnalysisView analysis={analysis} />);
+    const provenance = view.querySelector("dl")!.textContent ?? "";
+    expect(provenance).toContain("ckpt_audio_text.pt");
+    expect(provenance).toContain(
+      String(analysis.provenance.checkpoint!.sha256).slice(0, 12),
+    );
+    expect(provenance).toContain("p0");
+    expect(provenance).toContain("ninguna (V0)");
+    expect(provenance).toContain("mrcd.analysis/v1");
+  });
+
+  it("lista las advertencias del motor", () => {
+    const view = mount(<DisfluencyAnalysisView analysis={analysis} />);
+    const warnings = view.querySelector(
+      "ul[aria-label='Advertencias del motor']",
+    )!;
+    expect(warnings.querySelectorAll("li").length).toBe(
+      analysis.warnings.length,
+    );
+    expect(warnings.textContent).toContain("scores_uncalibrated");
+  });
+
+  it("marca como experimental un resultado con perfil ASR P1", () => {
+    const view = mount(
+      <DisfluencyAnalysisView analysis={MrcdAnalysisSchema.parse(okP1)} />,
+    );
+    expect(view.textContent).toContain("Resultado experimental");
+    expect(view.textContent).toContain("asr_profile:p1_disfluent_prompt");
+  });
+
+  it("sin eventos no certifica fluidez y no rellena la tasa con 0", () => {
+    const empty = MrcdAnalysisSchema.parse({
+      ...okP0,
+      events: [],
+      summary: {
+        n_events: 0,
+        events_per_minute: {
+          available: false,
+          value: null,
+          unavailable_reason:
+            "audio shorter than 1 s: a per-minute rate is not meaningful",
+        },
+        counts_by_class: {},
+      },
+    });
+    const view = mount(<DisfluencyAnalysisView analysis={empty} />);
+    const text = view.textContent ?? "";
+    expect(text).toContain("no certifica un habla fluida");
+    expect(text).toContain("No disponible: audio shorter than 1 s");
+    expect(view.querySelector("table")).toBeNull();
+  });
+
+  it("un documento de error no inventa un resumen (todo queda no disponible)", () => {
+    const failed = MrcdAnalysisSchema.parse(errorStereo);
+    const view = mount(<DisfluencyAnalysisView analysis={failed} />);
+    const text = view.textContent ?? "";
+    expect(text).toContain("No disponible: sin resumen");
+    expect(view.querySelector("table")).toBeNull();
+  });
+
+  it("no contiene lenguaje de inferencia psicológica ni diagnóstico", () => {
+    const view = mount(<DisfluencyAnalysisView analysis={analysis} />);
+    const text = (view.textContent ?? "").toLowerCase();
+    for (const word of [
+      "ansiedad",
+      "nervios",
+      "duda",
+      "tartamud",
+      "diagnóstico",
+      "incierto",
+    ]) {
+      expect(text).not.toContain(word);
+    }
+  });
+});
diff --git a/frontend/src/contexts/feedback/components/DisfluencyEventsSection.tsx b/frontend/src/contexts/feedback/components/DisfluencyEventsSection.tsx
