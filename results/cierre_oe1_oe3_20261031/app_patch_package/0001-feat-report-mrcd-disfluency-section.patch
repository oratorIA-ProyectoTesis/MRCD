@@ -0,0 +1,293 @@
+/**
+ * Cliente del servicio MRCD (contrato `mrcd.analysis/v1`).
+ *
+ * El servicio MRCD vive en OTRO repositorio y proceso (`C:\zArnes-tesis\mrcd`,
+ * `python -m mrcd.service serve`). Este módulo solo habla su contrato HTTP; no
+ * importa nada del motor.
+ *
+ * Reglas que este cliente impone a propósito:
+ * - Sin credenciales: NO usa `apiFetch` (que adjunta el bearer de OratorIA) ni
+ *   envía cookies. La URL llega por `VITE_MRCD_SERVICE_URL`; no hay claves.
+ * - El puntaje se valida como `calibrated: false` / `label: "uncalibrated"`. Si el
+ *   servicio alguna vez dejara de decirlo, el esquema rechaza la respuesta
+ *   en vez de mostrar una certeza que el motor no respalda.
+ * - Una medida ausente es `{ available: false, value: null, unavailable_reason }`;
+ *   nunca se convierte en 0.
+ */
+import { z } from "zod";
+
+export const MRCD_ANALYSIS_VERSION = "mrcd.analysis/v1";
+export const MRCD_JOB_VERSION = "mrcd.job/v1";
+
+function measure<T extends z.ZodType>(value: T) {
+  return z.union([
+    z.object({
+      available: z.literal(true),
+      value,
+      unavailable_reason: z.null(),
+    }),
+    z.object({
+      available: z.literal(false),
+      value: z.null(),
+      unavailable_reason: z.string().min(1),
+    }),
+  ]);
+}
+
+const modalityStatus = z.union([
+  z.object({ available: z.literal(true), reason: z.null() }),
+  z.object({ available: z.literal(false), reason: z.string().min(1) }),
+]);
+
+const looseObject = z.record(z.string(), z.unknown());
+
+export const MrcdEventSchema = z.object({
+  id: z.string(),
+  class: z.string().min(1),
+  start_s: z.number().min(0),
+  end_s: z.number().min(0),
+  interval_semantics: z.literal("decision_stride_not_human_boundary"),
+  score: z.object({
+    value: z.number().min(0).max(1),
+    kind: z.enum(["max_window_softmax_score", "max_window_class_probability"]),
+    calibrated: z.literal(false),
+    label: z.literal("uncalibrated"),
+  }),
+  n_windows: z.number().int().min(1),
+  modalities_used: z.array(z.string()),
+  text: z.string().nullable(),
+  validation: z.string().nullable(),
+  experimental: z.boolean(),
+});
+export type MrcdEvent = z.infer<typeof MrcdEventSchema>;
+
+export const MrcdErrorSchema = z.object({
+  code: z.string().min(1),
+  message: z.string().min(1),
+  retryable: z.boolean(),
+  details: looseObject,
+});
+
+export const MrcdAnalysisSchema = z.object({
+  schema_version: z.literal(MRCD_ANALYSIS_VERSION),
+  status: z.enum(["completed", "failed"]),
+  generated_at: z.string(),
+  error: MrcdErrorSchema.nullable(),
+  request: z.object({
+    audio_sha256: z.string().nullable(),
+    audio_duration_s: measure(z.number()),
+    sample_rate_hz: measure(z.number().int()),
+    channels: measure(z.number().int()),
+    asr_profile: z.string(),
+    head: z.string().nullable(),
+    include_text: z.boolean(),
+  }),
+  events: z.array(MrcdEventSchema),
+  summary: z
+    .object({
+      n_events: z.number().int().min(0),
+      events_per_minute: measure(z.number()),
+      counts_by_class: z.record(z.string(), z.number().int()),
+    })
+    .nullable(),
+  modalities: z.object({
+    acoustic: modalityStatus,
+    linguistic: modalityStatus,
+    kinesic_video: modalityStatus,
+  }),
+  provenance: z.object({
+    service: looseObject,
+    checkpoint: looseObject.nullable(),
+    asr: looseObject.nullable(),
+    head: looseObject.nullable(),
+    config: looseObject.nullable(),
+    environment: looseObject.nullable(),
+  }),
+  experimental: z.object({
+    active: z.boolean(),
+    components: z.array(z.string()),
+  }),
+  head_decision: looseObject.nullable(),
+  transcript: z.string().nullable(),
+  warnings: z.array(z.object({ code: z.string(), message: z.string() })),
+});
+export type MrcdAnalysis = z.infer<typeof MrcdAnalysisSchema>;
+
+export const MrcdJobSchema = z.object({
+  schema_version: z.literal(MRCD_JOB_VERSION),
+  job_id: z.string(),
+  status: z.enum(["queued", "running", "completed", "failed"]),
+  created_at: z.string(),
+  result: MrcdAnalysisSchema.nullable(),
+});
+export type MrcdJob = z.infer<typeof MrcdJobSchema>;
+
+/** Error del servicio (contrato) o del cliente (`client_*`). */
+export class MrcdServiceError extends Error {
+  readonly code: string;
+  readonly retryable: boolean;
+
+  constructor(code: string, message: string, retryable = false) {
+    super(message);
+    this.name = "MrcdServiceError";
+    this.code = code;
+    this.retryable = retryable;
+  }
+}
+
+/** Base del servicio o `null` si no está configurado (la función queda "no disponible"). */
+export function mrcdServiceUrl(): string | null {
+  const raw = import.meta.env.VITE_MRCD_SERVICE_URL?.trim();
+  return raw ? raw.replace(/\/+$/, "") : null;
+}
+
+export interface AnalyzeOptions {
+  /** Perfil ASR. Por defecto el servicio usa `p0`; `p1_disfluent_prompt` es EXPERIMENTAL. */
+  asrProfile?: string;
+  signal?: AbortSignal;
+  pollIntervalMs?: number;
+  timeoutMs?: number;
+  baseUrl?: string;
+  fetchImpl?: typeof fetch;
+}
+
+function failureFrom(analysis: MrcdAnalysis): MrcdServiceError {
+  const e = analysis.error;
+  return new MrcdServiceError(
+    e?.code ?? "client_unknown_failure",
+    e?.message ?? "El servicio MRCD informó un fallo sin detalle.",
+    e?.retryable ?? false,
+  );
+}
+
+async function readJson(response: Response): Promise<unknown> {
+  try {
+    return await response.json();
+  } catch {
+    throw new MrcdServiceError(
+      "client_bad_response",
+      "El servicio MRCD respondió con un cuerpo que no es JSON.",
+    );
+  }
+}
+
+/**
+ * Envía el audio (WAV PCM16 mono 16 kHz) al servicio, espera el trabajo y devuelve el
+ * análisis validado. Lanza `MrcdServiceError` con el código estructurado del servicio.
+ */
+export async function analyzeAudioWithMrcd(
+  audio: Blob,
+  options: AnalyzeOptions = {},
+): Promise<MrcdAnalysis> {
+  const base = options.baseUrl ?? mrcdServiceUrl();
+  if (!base) {
+    throw new MrcdServiceError(
+      "client_not_configured",
+      "VITE_MRCD_SERVICE_URL no está configurada: el análisis de disfluencias no está disponible.",
+    );
+  }
+  const doFetch = options.fetchImpl ?? fetch;
+  const query = options.asrProfile
+    ? `?asr_profile=${encodeURIComponent(options.asrProfile)}`
+    : "";
+  const common: RequestInit = {
+    credentials: "omit",
+    signal: options.signal,
+  };
+
+  let created: Response;
+  try {
+    created = await doFetch(`${base}/v1/jobs${query}`, {
+      ...common,
+      method: "POST",
+      headers: { "Content-Type": "audio/wav" },
+      body: audio,
+    });
+  } catch {
+    throw new MrcdServiceError(
+      "client_unreachable",
+      "No se pudo contactar el servicio MRCD. ¿Está levantado y permite este origen (CORS)?",
+      true,
+    );
+  }
+  const createdBody = await readJson(created);
+  if (!created.ok) {
+    const failed = MrcdAnalysisSchema.safeParse(createdBody);
+    throw failed.success
+      ? failureFrom(failed.data)
+      : new MrcdServiceError(
+          "client_bad_response",
+          `Respuesta inesperada del servicio MRCD (HTTP ${created.status}).`,
+        );
+  }
+  let job = parseJob(createdBody);
+
+  const started = Date.now();
+  const timeoutMs = options.timeoutMs ?? 600_000;
+  const interval = options.pollIntervalMs ?? 1_000;
+  while (job.status === "queued" || job.status === "running") {
+    if (Date.now() - started > timeoutMs) {
+      throw new MrcdServiceError(
+        "client_timeout",
+        "El análisis MRCD no terminó en el tiempo esperado.",
+        true,
+      );
+    }
+    await new Promise((resolve) => setTimeout(resolve, interval));
+    let polled: Response;
+    try {
+      polled = await doFetch(`${base}/v1/jobs/${job.job_id}`, {
+        ...common,
+        method: "GET",
+      });
+    } catch {
+      throw new MrcdServiceError(
+        "client_unreachable",
+        "Se perdió la conexión con el servicio MRCD mientras se esperaba el resultado.",
+        true,
+      );
+    }
+    const body = await readJson(polled);
+    if (!polled.ok) {
+      const failed = MrcdAnalysisSchema.safeParse(body);
+      throw failed.success
+        ? failureFrom(failed.data)
+        : new MrcdServiceError(
+            "client_bad_response",
+            `Respuesta inesperada del servicio MRCD (HTTP ${polled.status}).`,
+          );
+    }
+    job = parseJob(body);
+  }
+  if (!job.result) {
+    throw new MrcdServiceError(
+      "client_bad_response",
+      "El trabajo terminó sin resultado.",
+    );
+  }
+  if (job.status === "failed" || job.result.status === "failed") {
+    throw failureFrom(job.result);
+  }
+  return job.result;
+}
+
+function parseJob(body: unknown): MrcdJob {
+  const parsed = MrcdJobSchema.safeParse(body);
+  if (!parsed.success) {
+    const version =
+      typeof body === "object" && body !== null && "schema_version" in body
+        ? String((body as { schema_version: unknown }).schema_version)
+        : "";
+    if (version !== MRCD_JOB_VERSION) {
+      throw new MrcdServiceError(
+        "contract_version_unsupported",
+        `Versión de contrato no soportada por este cliente: ${version || "desconocida"} (se esperaba ${MRCD_JOB_VERSION}).`,
+      );
+    }
+    throw new MrcdServiceError(
+      "client_contract_violation",
+      "La respuesta del servicio MRCD no cumple el contrato mrcd.job/v1; se descarta.",
+    );
+  }
+  return parsed.data;
+}
