flowchart LR
  subgraph browser["Browser on the user device (video never leaves it) [trust boundary]"]
    spa["<b>Web SPA</b><br/><i>React 19, Vite, AudioWorklet, MediaPipe worker</i><br/>getUserMedia mono; PCM16 16 kHz 160 ms chunks; vision and prosody summaries (~1/s); opt-in consent UI; ReportPage with the MRCD section (3 classes by default); progress via fetch + Bearer SSE. No video upload."]:::app
    rec["<b>Local recording (research, optional)</b><br/><i>MediaRecorder</i><br/>Records video+audio and only downloads it locally; keeps a local reference."]:::app
  end
  subgraph backend["App backend (docker compose, local) [trust boundary]"]
    api["<b>Backend API</b><br/><i>FastAPI, WS /ws/session, REST /api/v1/sessions</i><br/>Authenticates, frames audio, runs the ASR port, closes segments, stores transcript and report. Hands the session PCM to the MRCD integration only for accounts with an active consent."]:::app
    asrport["<b>ASR adapter port</b><br/><i>SpeechRecognizer port</i><br/>ORATORIA_ASR_ADAPTER: speechmatics (configuration used), whisper_http (local compose default), simulado (code default), gestionado, deepgram, oratoria_engine."]:::app
    engine0["<b>ORATORIA-ENGINE v0 (embedded)</b><br/><i>Python, separate repo</i><br/>Detector v0 FP/REP/PRO, uncalibrated. This is what the app hosts today."]:::app
    mrcdint["<b>MRCD integration (platform/mrcd)</b><br/><i>Python, in-process in the backend</i><br/>Versioned opt-in consent; SessionAudioBuffer in RAM only (option B); capacity limits; mode incremental (default since app commit 960c351) | offline (fallback) | incremental_verify; HttpMrcdClient; IncrementalUploader (B incremental); result allow-list (text always null); ProgressHub SSE (counts only) behind the app's Bearer auth. Falls back to the offline job on any incremental failure."]:::app
    db["<b>PostgreSQL</b><br/><i>Database</i><br/>Sessions, transcript, report, consent decision (date + text version) and the sanitized MRCD document. No raw-audio persistence."]:::app
  end
  subgraph cloud["Third-party cloud [trust boundary]"]
    cloudasr["<b>ASR provider</b><br/><i>External API</i><br/>Receives audio when a cloud adapter is configured."]:::ext
  end
  subgraph mrcdp["MRCD local Python process / working tree [trust boundary]"]
    svc["<b>[PRODUCT] MRCD service (offline jobs + CLI)</b><br/><i>mrcd/service, FastAPI loopback :8765 / CLI</i><br/>GET /v1/health, /v1/schema; POST /v1/jobs + GET /v1/jobs/{id} (offline reference and the app's fallback); contract mrcd.analysis/v1. One engine worker thread, priority queue. No auth, loopback only. Preloads enabled ASR profiles and optionally warms up at start. Console command mrcd; product page at / with docs on."]:::cur
    incr["<b>[OPT-IN] Incremental sessions</b><br/><i>mrcd/service/incremental, /v1/sessions</i><br/>POST /v1/sessions (returns subscription_token once); PUT /audio/{seq} (idempotent PCM16 batches); POST /close; GET /events (SSE, counts only); GET state; DELETE. Per-session ChunkCache of 8 s ASR fragments. Profiles p0/p1 on CPU only; noloop and cuda are refused (offline job instead)."]:::cur
    lib["<b>mrcd library</b><br/><i>Python package mrcd 0.4.0</i><br/>DisfluencyEngine.load/analyze/analyze_file -> AnalysisResult(Event, Window). Only supported entry; everything else is internal. Also holds the opt-in and research packages (av, optimize, context_ambiguity, recording_check, calibration, fusion_text), see level 3."]:::cur
    demo["<b>Live demo</b><br/><i>scripts/live_demo.py, FastAPI :8001</i><br/>Microphone -> LiveScorer rows -> WebSocket /ws and dashboard. Not an API for other systems."]:::cur
    scripts["<b>Research and batch scripts</b><br/><i>scripts/*.py, argparse</i><br/>Dataset, training, parity, ASR recovery, audits. No console_scripts and no CLI around analyze_file."]:::cur
    artifacts["<b>Model artifacts</b><br/><i>Files</i><br/>mrcd/weights/ckpt_audio_text.pt (packaged, sha256 pinned; same bytes as models/), Vc head (sha256 pinned), faster-whisper small cache."]:::ext
    results["<b>Results store</b><br/><i>results/ (git-ignored)</i><br/>Reports, logs, JSON. Only force-added files are versioned."]:::ext
  end
