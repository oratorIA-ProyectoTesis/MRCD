  subgraph feat["Feature extraction (shared by offline and live)"]
    acoustic["<b>Acoustic extractor</b><br/><i>extractors/acoustic.py</i><br/>Silero VAD, pYIN F0, RMS at 100 fps -> 5-D frames."]:::cur
    prosody["<b>Prosody extractor</b><br/><i>extractors/prosody.py</i><br/>9-D boundary features around the longest silence."]:::cur
    windows["<b>Window tensors</b><br/><i>dataset.py, windowing.py</i><br/>acoustic_windows, linguistic_windows (10 s context, +2 columns), center_f0; short-unit planning."]:::cur
    sync["<b>A/V sync buffer</b><br/><i>sync/buffer.py</i><br/>Aligns audio and kinesic by capture timestamp. Imported by dataset.py; not in the live path."]:::cur
    kin["<b>Kinesic and face tracking</b><br/><i>extractors/kinesic.py, face_tracking.py</i><br/>MediaPipe 12-D. Reached only by offline video scripts; analyze() rejects video modes."]:::cur
    ling["<b>Linguistic extractor + ASR</b><br/><i>extractors/linguistic.py</i><br/>VerbatimASR (faster-whisper), transcribe_chunked 8 s / 2 s, 10 word features."]:::cur
  end
  subgraph api["Public API and constants"]
    pub["<b>Engine facade</b><br/><i>engine.py, __init__.py</i><br/>DisfluencyEngine, Event, Window, AnalysisResult; grid 3 s / 0.5 s; _merge; _run_head."]:::cur
    consts["<b>Constants</b><br/><i>constants.py</i><br/>Taxonomy (7 + fluent), SAMPLE_RATE, WINDOW_S, STRIDE_S, CONTEXT_S, FEATURE_SCHEMA_VERSION, H."]:::cur
    service["<b>[PRODUCT] Service surface</b><br/><i>service/{analyzer,contract,server,cli,audio_io,validate}.py</i><br/>Offline job API on loopback (mrcd.analysis/v1, ASR profile and options per request). Wraps DisfluencyEngine; not imported by the engine."]:::cur
  end
  subgraph model["Model, ASR profile and head"]
    fusion["<b>Fusion network</b><br/><i>models/fusion.py</i><br/>CrossModalFusion; audio_text checkpoint has 75,144 parameters; logits over 8 labels."]:::cur
    infer["<b>Checkpoint and inference</b><br/><i>inference.py</i><br/>load_ckpt (fails on schema mismatch), predict = softmax."]:::cur
    head["<b>Vc head (experimental)</b><br/><i>adaptation.py</i><br/>Hash-pinned MLP on pooled features; max over windows vs frozen thresholds; not calibrated."]:::cur
    decision["<b>Decision utilities</b><br/><i>decision.py</i><br/>unit_score, three_state, CV thresholds. NOT called by the engine."]:::cur
    profiles["<b>ASR profiles</b><br/><i>asr_profiles.py</i><br/>p0 (default); opt-in experimental: p1_disfluent_prompt, p0/p1_noloop (loop re-decode, not bit-reproducible), p0/p1_cuda; fingerprint, asr_cache_key, anomaly heuristics."]:::cur
    repro["<b>Reproducibility</b><br/><i>reproducibility.py</i><br/>OMP pin/status/warning, file sha256, engine_environment."]:::cur
  end
  subgraph kit["Research kits (not imported by the engine)"]
    anno["<b>Weak annotation</b><br/><i>annotation/auto_labeler.py</i><br/>Heuristic cascade that produced the TRAINING labels (seconds-based thresholds). Not used at inference."]:::cur
    corp["<b>Corpus importers</b><br/><i>corpora/*</i><br/>DIHANA, DIME, ESLORA importers; absence of a label = unknown."]:::cur
    ctxeval["<b>Context evaluation</b><br/><i>context_eval/*</i><br/>DIHANA folds 1-4 repetition/revision experiment (exploratory)."]:::cur
    asrrec["<b>ASR recovery experiment</b><br/><i>asr_recovery/*</i><br/>P0/P1/P2 decoding study (exploratory)."]:::cur
  end
  subgraph live["Live path (testable without a microphone)"]
    sasr["<b>Streaming ASR</b><br/><i>live/streaming_asr.py</i><br/>Re-transcribes the last 13 s and merges words by absolute time."]:::cur
    tracker["<b>Session feature tracker</b><br/><i>live/session_features.py, pyin_carry.py</i><br/>Incremental VAD/F0/frames with margins L/R; exact Viterbi resume in v3."]:::cur
    scorer["<b>LiveScorer and configs</b><br/><i>live/session.py</i><br/>live_cfg_v1/v2/v3; step and finalize; rows provisional / final."]:::cur
    mic["<b>Microphone stream</b><br/><i>live/mic_stream.py</i><br/>AudioRingBuffer, SessionRecorder, MicrophoneStream (sounddevice, extra demo). Driven by scripts/live_demo.py."]:::cur
    wbuild["<b>Window builder</b><br/><i>live/window_builder.py</i><br/>window_text; offline-equivalent tensor builder kept for tests."]:::cur
  end
  subgraph svcinc["Service: decision profile (default), incremental sessions and opt-in text route"]
    incr["<b>[OPT-IN] Incremental session</b><br/><i>service/incremental/{session,routes,plan}.py</i><br/>SessionRegistry/IncrementalSession (token, seq gap check, byte budget, idle sweep), /v1/sessions routes, integer chunk plan (8 s fragments, 6 s step). Close reruns the OFFLINE path over the canonical WAV."]:::cur
    ccache["<b>[OPT-IN] Chunk cache + CachedASR</b><br/><i>service/incremental/{cache,cached_asr}.py</i><br/>In-memory per-session cache keyed by ASR namespace, position and sha256 of the fragment; CachedASR inherits the unchanged transcribe_chunked, so a miss only costs latency. Never persisted."]:::cur
    warm["<b>[PRODUCT] Preload and warm-up</b><br/><i>service/incremental/warmup.py</i><br/>One analysis of a fixed synthetic 13 s signal per preloaded profile, result discarded; makes process state identical for offline and incremental runs."]:::cur
    s3feat["<b>[OPT-IN] S3 service features</b><br/><i>service/s3_features.py</i><br/>Experimental P1 text route and optional three-state decision; calibration_claim none; only when requested."]:::cur
    dprof["<b>[DEFAULT] Decision profile o2026_11</b><br/><i>service/decision_profile.py</i><br/>Service default (contract rev 1.4): filler_word / prolongation from the O-campaign pipelines on pause-delimited ASR segments; repetition keeps the engine decision. sha256-pinned plain-JSON artifacts, no pickle. v0 = historical, explicit."]:::cur
    fustext["<b>[OPT-IN] Text fusion route</b><br/><i>fusion_text.py</i><br/>Weighted LR text route (ctx_LR), rule+model fusion, serialisable route artifact."]:::cur
    calib["<b>[OPT-IN] Score calibration</b><br/><i>calibration.py</i><br/>Platt/isotonic, grouped cross-fitting, Brier/ECE, three-state decision. A score is not called calibrated without a separated check."]:::cur
  end
  subgraph optin["Research and opt-in packages (the service imports only optimize.safe_pipeline, via decision_profile)"]
    av["<b>[RESEARCH] A/V evidence gate</b><br/><i>av/*</i><br/>Technical admission gate (active speaker, identity, synchrony) and observable lip/face traits. Absence is an exclusion with a reason, never 0. No psychological inference."]:::cur
    recchk["<b>[OPT-IN] Recording check kit</b><br/><i>recording_check/*</i><br/>Technical validation of own recordings (video gate, AV sync, microphone, robustness). Produces no accuracy evidence; reads no labels."]:::cur
    ctxamb["<b>[RESEARCH] Context ambiguity</b><br/><i>context_ambiguity/*</i><br/>Occurrences of ambiguous forms in DIHANA turns; reference kept apart from the input view."]:::cur
    optim["<b>[RESEARCH] Classifier optimisation</b><br/><i>optimize/*</i><br/>Nested speaker-grouped search for filler/prolongation/repetition classifiers; product_pipeline packages them hash-verified as pickles (opt-in, DEFAULT_PIPELINE False); safe_pipeline exports the LR ones to JSON, which the service profile o2026_11 loads."]:::cur
  end
